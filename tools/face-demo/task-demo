# task-demo: hand a real task to the grok CLI and show its progress on the robot
#
# Usage:
#   GROKI_HOST=<robot's LAN address> GROKI_TOKEN=<MCP token> ./task-demo "帮我看看这个仓库里有几个 TODO"
#   Optional: GROKI_CWD, the task's working directory (default: the current directory)
#
# Flow: the robot shows the thinking face as the task goes out → grok works headless → excited face + a balloon with a summary of the result

set -uo pipefail
HOST=${GROKI_HOST:?请设 GROKI_HOST（设备局域网地址）}
TOKEN=${GROKI_TOKEN:?请设 GROKI_TOKEN（设置页 MCP token）}
TASK=${1:?用法: task-demo "<任务>"}
CWD=${GROKI_CWD:-$PWD}

if ! command -v grok >/dev/null 2>&1; then
    print -u2 "找不到 grok CLI，请先安装并确保 grok 在 PATH 中"
    exit 1
fi

post() { # post <path> <body> [query]
    curl -sS -m 5 -X POST "http://$HOST$1${3:-}" \
        -H "Authorization: Bearer $TOKEN" \
        --data-binary "$2" -o /dev/null -w '%{http_code}'
}

expr_set() {
    local code=$(post /mcp/expression "$1")
    [ "$code" = 200 ] || print -u2 "表情 $1 设置返回 $code"
}

print "→ 设备进入思考…"
expr_set thinking

print "→ 派给 grok：$TASK"
OUT=$(grok --no-auto-update -p "$TASK" -m grok-4.6 --output-format json --always-approve --cwd "$CWD" 2>/dev/null)
RC=$?

if [ $RC -ne 0 ] || [ -z "$OUT" ]; then
    expr_set confused
    post /mcp/balloon "任务没跑成，先给你个疑惑脸" "?hold_ms=6000" >/dev/null
    print -u2 "grok 退出码 $RC"
    exit 1
fi

# Take the final reply text from the JSON output, squash it to one line and cut it to 60 characters for the balloon
SUMMARY=$(print -- "$OUT" | python3 -c "
import json,sys
try:
    d=json.load(sys.stdin)
    t=d.get('result') or d.get('response') or d.get('text') or ''
    if not t and isinstance(d, list):
        t=' '.join(str(x.get('text','')) for x in d if isinstance(x,dict))
except Exception:
    t=sys.stdin.read()
t=' '.join(str(t).split())
print(t[:60] or '完成')
")

print "→ 完成：$SUMMARY"
expr_set excited
post /mcp/balloon "$SUMMARY" "?hold_ms=10000" >/dev/null

sleep 10
expr_set neutral
print "→ 结束"
