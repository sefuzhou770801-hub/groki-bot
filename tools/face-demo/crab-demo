# crab-demo — 给 grok CLI 派真任务，设备外化任务状态
#
# 用法：
#   CRAB_HOST=<设备局域网地址> CRAB_TOKEN=<MCP token> ./crab-demo "帮我看看这个仓库里有几个 TODO"
#   可选：CRAB_CWD 任务工作目录（默认当前目录）
#
# 流程：派出瞬间设备进思考脸 → grok headless 干活 → 完成后兴奋脸 + 气泡展示结果摘要
# 彩排检查点：表情切换肉眼确认；气泡文字可读；播报（若开）人耳确认（HTTP 200 不算数）。

set -uo pipefail
HOST=${CRAB_HOST:?请设 CRAB_HOST（设备局域网地址）}
TOKEN=${CRAB_TOKEN:?请设 CRAB_TOKEN（设置页 MCP token）}
TASK=${1:?用法: crab-demo "<任务>"}
CWD=${CRAB_CWD:-$PWD}

if ! command -v grok >/dev/null 2>&1; then
    print -u2 "找不到 grok CLI，请先安装并确保 grok 在 PATH 中"
    exit 1
fi

crab() { # crab <路径> <body> [query]
    curl -sS -m 5 -X POST "http://$HOST$1${3:-}" \
        -H "Authorization: Bearer $TOKEN" \
        --data-binary "$2" -o /dev/null -w '%{http_code}'
}

expr_set() {
    local code=$(crab /mcp/expression "$1")
    [ "$code" = 200 ] || print -u2 "表情 $1 设置返回 $code"
}

print "→ 设备进入思考…"
expr_set thinking

print "→ 派给 grok：$TASK"
OUT=$(grok --no-auto-update -p "$TASK" -m grok-4.6 --output-format json --always-approve --cwd "$CWD" 2>/dev/null)
RC=$?

if [ $RC -ne 0 ] || [ -z "$OUT" ]; then
    expr_set confused
    crab /mcp/balloon "任务没跑成，先给你个疑惑脸" "?hold_ms=6000" >/dev/null
    print -u2 "grok 退出码 $RC"
    exit 1
fi

# 从 JSON 输出提取最终回复文本，压成一行截 60 字进气泡
SUMMARY=$(print -- "$OUT" | python3 -c "
import json,sys
try:
    d=json.load(sys.stdin)
    t=d.get('result') or d.get('response') or d.get('text') or ''
    if not t and isinstance(d, list):
        t=' '.join(str(x.get('text','')) for x in d if isinstance(x,dict))
except Exception:
    t=sys.stdin.read()
t=' '.join(str(t).split())
print(t[:60] or '完成')
")

print "→ 完成：$SUMMARY"
expr_set excited
crab /mcp/balloon "$SUMMARY" "?hold_ms=10000" >/dev/null

sleep 10
expr_set neutral
print "→ 演示段结束"
